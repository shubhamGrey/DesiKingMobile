{
  "expo": {
    "name": "DesiKing",
    "slug": "desiking-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#1f4f40"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.desiking.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1f4f40"
      },
      "package": "com.desiking.app",
      "versionCode": 4,
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "cd97c3bd-dd89-4f14-8f80-96fe47fad3ba"
      },
      "apiUrl": "https://desikingspices.com/app"
    }
  }
}
